{
  "name": "cognates",
  "version": "1.0.0",
  "description": "Cognates is a lightweight and developer-friendly npm package for localizing strings in React applications. It simplifies internationalization (i18n) by providing an easy-to-use API for managing translations, supporting multiple languages, and enhancing user experience with seamless locale switching.",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "import": "./index.js",
      "require": "./index.js"
    }
  },
  "scripts": {
    "dev": "cd \"ui\" && npm run dev",
    "build": "cd \"ui\" && npm run build",
    "start": "cd \"../../Test Environment\" && npx cognates start",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix"
  },
  "bin": {
    "cognates": "./bin/cognates.js"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/notakshayrajput/cognates.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/notakshayrajput/cognates/issues"
  },
  "homepage": "https://github.com/notakshayrajput/cognates#readme",
  "dependencies": {
    "@glideapps/glide-data-grid": "^6.0.3",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "express": "^4.21.2",
    "open": "^10.1.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.10",
    "@typescript-eslint/eslint-plugin": "^8.25.0",
    "@typescript-eslint/parser": "^8.25.0",
    "eslint": "^9.21.0",
    "eslint-config-prettier": "^10.0.2",
    "eslint-plugin-prettier": "^5.2.3",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.1.0",
    "prettier": "^3.5.2",
    "typescript": "^5.7.3",
    "vite": "^6.2.0"
  }
}
