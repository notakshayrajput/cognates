{
  "name": "cognates",
  "version": "1.0.0",
  "description": "CLI and local browser editor for managing JSON translations and checking locale files.",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./index.d.ts",
        "default": "./index.js"
      },
      "require": {
        "types": "./index.d.cts",
        "default": "./index.cjs"
      }
    }
  },
  "files": [
    "bin/",
    "commands/",
    "lib/",
    "example/",
    "ui/dist/",
    "defineConfig.js",
    "index.js",
    "index.cjs",
    "index.d.ts",
    "index.d.cts",
    "scripts/prepare-package.mjs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "cd \"ui\" && npm run dev",
    "build": "npm run build --prefix ui",
    "test": "node --test",
    "typecheck": "tsc --noEmit --module nodenext --moduleResolution nodenext --target es2022 type-tests/esm.mts type-tests/commonjs.cts",
    "prepack": "node scripts/prepare-package.mjs",
    "prepublishOnly": "npm test && npm run lint && npm run typecheck",
    "install:local": "node scripts/install-local.mjs",
    "start": "cd \"Test Environment\" && npx cognates start",
    "lint": "eslint . --ext .js,.cjs,.mjs",
    "lint:fix": "eslint . --ext .js,.cjs,.mjs --fix"
  },
  "bin": {
    "cognates": "./bin/cognates.js"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/notakshayrajput/cognates.git"
  },
  "keywords": ["i18n", "localization", "translations", "locale", "cli", "json"],
  "author": "Akshay Rajput",
  "license": "ISC",
  "engines": {
    "node": ">=20"
  },
  "bugs": {
    "url": "https://github.com/notakshayrajput/cognates/issues"
  },
  "homepage": "https://github.com/notakshayrajput/cognates#readme",
  "dependencies": {
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "express": "^4.21.2",
    "open": "^10.1.0"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.25.0",
    "@typescript-eslint/parser": "^8.25.0",
    "eslint": "^9.21.0",
    "eslint-config-prettier": "^10.0.2",
    "eslint-plugin-prettier": "^5.2.3",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.1.0",
    "prettier": "^3.5.2",
    "typescript": "^5.7.3",
    "vite": "^6.2.0"
  }
}
